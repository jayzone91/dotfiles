#!/usr/bin/env bash

set -euo pipefail

SOURCE="${HOME}/.config/theme/catppuccin-mocha.css"
TARGET="${HOME}/.config/hypr/hyprlock-colors.conf"

if [[ ! -f "$SOURCE" ]]; then
    printf 'Theme-Datei wurde nicht gefunden: %s\n' "$SOURCE" >&2
    exit 1
fi

get_color() {
    local name="$1"
    local value

    value="$(
        awk -v requested="$name" '
            $1 == "@define-color" && $2 == requested {
                gsub(/^#/, "", $3)
                gsub(/;$/, "", $3)
                print $3
                exit
            }
        ' "$SOURCE"
    )"

    if [[ -z "$value" ]]; then
        printf 'Farbe nicht gefunden: %s\n' "$name" >&2
        exit 1
    fi

    printf '%s' "$value"
}

cat > "$TARGET" <<COLORS
# Automatisch aus catppuccin-mocha.css erzeugt.
# Diese Datei nicht manuell bearbeiten.

\$rosewater = rgb($(get_color rosewater))
\$flamingo  = rgb($(get_color flamingo))
\$pink      = rgb($(get_color pink))
\$mauve     = rgb($(get_color mauve))
\$red       = rgb($(get_color red))
\$maroon    = rgb($(get_color maroon))
\$peach     = rgb($(get_color peach))
\$yellow    = rgb($(get_color yellow))
\$green     = rgb($(get_color green))
\$teal      = rgb($(get_color teal))
\$sky       = rgb($(get_color sky))
\$sapphire  = rgb($(get_color sapphire))
\$blue      = rgb($(get_color blue))
\$lavender  = rgb($(get_color lavender))

\$text      = rgb($(get_color text))
\$subtext1  = rgb($(get_color subtext1))
\$subtext0  = rgb($(get_color subtext0))
\$overlay2  = rgb($(get_color overlay2))
\$overlay1  = rgb($(get_color overlay1))
\$overlay0  = rgb($(get_color overlay0))
\$surface2  = rgb($(get_color surface2))
\$surface1  = rgb($(get_color surface1))
\$surface0  = rgb($(get_color surface0))
\$base      = rgb($(get_color base))
\$mantle    = rgb($(get_color mantle))
\$crust     = rgb($(get_color crust))

# Varianten mit Transparenz
\$base90     = rgba($(get_color base)e6)
\$base80     = rgba($(get_color base)cc)
\$mantle90   = rgba($(get_color mantle)e6)
\$surface090 = rgba($(get_color surface0)e6)
\$blue60     = rgba($(get_color blue)99)
\$mauve60    = rgba($(get_color mauve)99)
\$green60    = rgba($(get_color green)99)
\$red60      = rgba($(get_color red)99)
COLORS

printf 'Hyprlock-Farben erzeugt: %s\n' "$TARGET"
