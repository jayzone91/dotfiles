{
  "layer": "top",
  "position": "top",
  "height": 38,
  "spacing": 8,
  "margin-top": 8,
  "margin-left": 12,
  "margin-right": 12,

  "modules-left": [
    "custom/launcher",
    "custom/ws1",
    "custom/ws2",
    "custom/ws3",
    "custom/ws4",
    "custom/ws5",
    "hyprland/window"
  ],

  "modules-center": [
    "clock"
  ],

  "modules-right": [
    "tray",
    "cpu",
    "memory",
    "temperature",
    "network",
    "bluetooth",
    "pulseaudio",
    "custom/notifications",
    "custom/power"
  ],

  "custom/launcher": {
    "format": "",
    "tooltip": false,
    "on-click": "walker"
  },
	
  "custom/ws1": {
    "exec": "~/.config/waybar/scripts/workspace-watch 1",
    "return-type": "json",
    "format": "{}",
    "on-click": "~/.local/bin/workspace-cycle 1"
},

"custom/ws2": {
    "exec": "~/.config/waybar/scripts/workspace-watch 2",
    "return-type": "json",
    "format": "{}",
    "on-click": "~/.local/bin/workspace-cycle 2"
},


"custom/ws3": {
    "exec": "~/.config/waybar/scripts/workspace-watch 3",
    "return-type": "json",
    "format": "{}",
    "on-click": "~/.local/bin/workspace-cycle 3"
},

"custom/ws4": {
    "exec": "~/.config/waybar/scripts/workspace-watch 4",
    "return-type": "json",
    "format": "{}",
    "on-click": "~/.local/bin/workspace-cycle 4"
},

"custom/ws5": {
    "exec": "~/.config/waybar/scripts/workspace-watch 5",
    "return-type": "json",
    "format": "{}",
    "on-click": "~/.local/bin/workspace-cycle 5"
},


  "hyprland/window": {
    "format": "{}",
    "max-length": 55,
    "separate-outputs": true
  },

  "clock": {
    "format": "󰥔  {:%H:%M}",
    "format-alt": "󰃭  {:%A, %d. %B %Y}",
    "tooltip-format": "<big>{:%B %Y}</big>\n<tt><small>{calendar}</small></tt>"
  },

  "tray": {
    "icon-size": 17,
    "spacing": 8
  },

  "cpu": {
    "interval": 2,
    "format": "  {usage}%",
    "tooltip": true
  },

  "memory": {
    "interval": 2,
    "format": "  {percentage}%"
  },

  "temperature": {
    "critical-threshold": 85,
    "format": "  {temperatureC}°C",
    "format-critical": "  {temperatureC}°C"
  },

  "network": {
    "format-wifi": "󰤨  {signalStrength}%",
    "format-ethernet": "󰈀  {ipaddr}",
    "format-disconnected": "󰤭",
    "tooltip-format": "{ifname}\n{ipaddr}/{cidr}\n{bandwidthDownBytes} ↓  {bandwidthUpBytes} ↑",
    "on-click": "nm-connection-editor"
  },

  "bluetooth": {
    "format": "󰂯",
    "format-connected": "󰂱 {num_connections}",
    "format-disabled": "󰂲",
    "on-click": "blueman-manager"
  },

  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "󰝟",
    "format-icons": {
      "default": [
        "",
        "",
        ""
      ]
    },
    "on-click": "pavucontrol",
    "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "scroll-step": 5
  },

  "custom/notifications": {
    "format": "󰂚",
    "tooltip": false,
    "on-click": "swaync-client -t -sw",
    "on-click-right": "swaync-client -d -sw"
  },

  "custom/power": {
    "format": "",
    "tooltip": false,
    "on-click": "wlogout --buttons-per-row 5 --column-spacing 20 --margin-left 1250 --margin-right 1250 --margin-top 390 --margin-bottom 390"
  }
}
